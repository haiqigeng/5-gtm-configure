{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json",
  "$defs": {
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_claim": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "evidence_locator": {
              "type": "string",
              "minLength": 1
            },
            "native_sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "description",
            "evidence_locator",
            "native_sha256"
          ],
          "additionalProperties": false
        },
        "transformation": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "allow",
                "augment",
                "exclude"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "evidence_locator": {
              "type": "string",
              "minLength": 1
            },
            "native_sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "allowed_parameters": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "scope",
            "evidence_locator",
            "native_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "allow"
                  }
                }
              },
              "then": {
                "required": [
                  "allowed_parameters"
                ]
              }
            }
          ]
        },
        "event_data": {
          "type": "object",
          "properties": {
            "key_path": {
              "type": "string",
              "minLength": 1
            },
            "claiming_client_proof": {
              "type": "string",
              "minLength": 1
            },
            "evidence_locator": {
              "type": "string",
              "minLength": 1
            },
            "native_sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "key_path",
            "claiming_client_proof",
            "evidence_locator",
            "native_sha256"
          ],
          "additionalProperties": false
        }
      }
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "uniqueStrings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmpty"
      },
      "uniqueItems": true
    },
    "shapeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "shape"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmpty"
        },
        "shape": {
          "enum": [
            "scalar",
            "array",
            "object"
          ]
        }
      }
    },
    "fieldFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "field_scope",
        "destination_field",
        "requirement_ids",
        "source",
        "wire",
        "event_data",
        "destination"
      ],
      "properties": {
        "status": {
          "enum": [
            "proved",
            "blocked",
            "external"
          ]
        },
        "field_scope": {
          "enum": [
            "event-parameter",
            "user-property",
            "item-parameter",
            "control"
          ]
        },
        "destination_field": {
          "$ref": "#/$defs/nonEmpty"
        },
        "requirement_ids": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "source": {
          "$ref": "#/$defs/shapeNode"
        },
        "wire": {
          "$ref": "#/$defs/shapeNode"
        },
        "event_data": {
          "$ref": "#/$defs/shapeNode"
        },
        "destination": {
          "$ref": "#/$defs/shapeNode"
        },
        "claiming_client_proof": {
          "type": "string"
        },
        "receiver_owner": {
          "type": "string"
        },
        "transformation_owner": {
          "type": "string"
        },
        "blocker": {
          "type": "string"
        },
        "external_dependency": {
          "type": "string"
        },
        "missing_behavior": {
          "type": "string"
        },
        "runtime_verification_note": {
          "type": "string"
        }
      }
    },
    "mutationApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "locator",
        "object_key",
        "action",
        "requirement_ids",
        "payload_sha256"
      ],
      "properties": {
        "grade": {
          "const": "approved-input"
        },
        "locator": {
          "$ref": "#/$defs/nonEmpty"
        },
        "object_key": {
          "$ref": "#/$defs/nonEmpty"
        },
        "action": {
          "enum": [
            "create",
            "update",
            "replace",
            "rename",
            "pause",
            "unpause",
            "remove"
          ]
        },
        "requirement_ids": {
          "$ref": "#/$defs/uniqueStrings",
          "minItems": 1
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consent_topology_id",
        "destination",
        "requirement_ids",
        "consent_mode",
        "transport_behavior",
        "web_enforcement",
        "server_enforcement",
        "signal_authority",
        "signal_source",
        "unknown_state_behavior",
        "event_coverage",
        "intentional_double_gate",
        "server_tag_keys",
        "transporter_tag_keys",
        "transporter_destination_vendor_block"
      ],
      "properties": {
        "consent_topology_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "destination": {
          "$ref": "#/$defs/nonEmpty"
        },
        "requirement_ids": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "consent_mode": {
          "enum": [
            "strict-basic",
            "advanced-native",
            "product-specific",
            "client-policy-ungated"
          ]
        },
        "transport_behavior": {
          "enum": [
            "blocked",
            "always-transported",
            "conditionally-transported"
          ]
        },
        "web_enforcement": {
          "type": "object",
          "required": [
            "mechanism"
          ],
          "properties": {
            "mechanism": {
              "enum": [
                "cmp-lifecycle-plus-vendor-block",
                "business-trigger-plus-vendor-block",
                "transport-trigger-only",
                "google-consent-mode",
                "product-native",
                "none",
                "not-applicable",
                "firing-trigger-condition",
                "additional-consent-checks"
              ]
            }
          }
        },
        "server_enforcement": {
          "type": "object",
          "required": [
            "mechanism"
          ],
          "properties": {
            "mechanism": {
              "enum": [
                "incoming-google-consent-native",
                "server-template-native-consent",
                "server-additional-consent-check",
                "server-blocking-trigger",
                "none"
              ]
            },
            "template_support": {
              "type": "string"
            },
            "blocking_trigger_key": {
              "type": "string"
            }
          }
        },
        "signal_authority": {
          "enum": [
            "google-consent-mode",
            "third-party-cmp",
            "product-native",
            "none"
          ]
        },
        "signal_source": {
          "$ref": "#/$defs/nonEmpty"
        },
        "server_signal_path": {
          "type": "string"
        },
        "unknown_state_behavior": {
          "enum": [
            "deny",
            "native-product-behavior",
            "explicit-policy"
          ]
        },
        "event_coverage": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "intentional_double_gate": {
          "type": "boolean"
        },
        "double_gate_justification": {
          "type": "string"
        },
        "server_tag_keys": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "transporter_tag_keys": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "transporter_destination_vendor_block": {
          "type": "boolean"
        }
      }
    }
  }
}

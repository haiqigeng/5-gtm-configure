{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {
      "type": "string",
      "const": "view_item"
    },
    "ecommerce": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "description": "Currency of the items associated with the event, in 3-letter ISO 4217 format. * Value metrics on the view_item event to not contribute to revenue * If you set value then currency is required for revenue metrics to be computed accurately.",
          "enum": [
            "EUR"
          ]
        },
        "value": {
          "type": "number",
          "description": "Monetary value of the event’s items, excluding shipping and tax."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "description": "The ID of the item. *One of item_id or item_name is required."
              },
              "item_name": {
                "type": "string",
                "description": "The name of the item. *One of item_id or item_name is required."
              },
              "item_variant": {
                "type": "string",
                "description": "The item variant or unique code or description for additional item details/options."
              },
              "item_color": {
                "type": "string",
                "description": "Identifies the normalized color selected for the item.",
                "enum": [
                  "white",
                  "black",
                  "oak"
                ]
              },
              "price": {
                "type": "number",
                "description": "The monetary unit price of the item, in units of the specified currency parameter. If a discount applies to the item, set price to the discounted unit price and specify the unit price discount in the discount parameter."
              },
              "quantity": {
                "type": "number",
                "description": "Item quantity. If not set, quantity is set to 1."
              }
            },
            "required": [
              "item_id",
              "item_name",
              "price",
              "quantity"
            ],
            "allOf": [
              {
                "if": {
                  "type": "object"
                },
                "then": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "item_id"
                      ],
                      "properties": {
                        "item_id": {}
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "item_name"
                      ],
                      "properties": {
                        "item_name": {}
                      }
                    }
                  ]
                }
              }
            ]
          },
          "description": "The items for the event."
        }
      },
      "required": [
        "items"
      ]
    }
  },
  "required": [
    "ecommerce",
    "event"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ga4-tracking-plan/events/view_item.schema.json",
  "title": "dataLayer push contract for \"view_item\"",
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "ecommerce"
        ],
        "properties": {
          "ecommerce": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {}
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "ecommerce"
        ],
        "properties": {
          "ecommerce": {
            "type": "object",
            "required": [
              "currency"
            ],
            "properties": {
              "currency": {}
            }
          }
        }
      }
    }
  ]
}

{
  "version": 3,
  "description": "Static intended-to-saved GTM object-graph characterization cases; not browser/runtime tests.",
  "cases": [
    {
      "id": "ga4-metadata-and-trigger-order-normalize",
      "expected_pass": true,
      "expected": {
        "objects": [
          {
            "object_type": "tag",
            "type": "gaawe",
            "name": "GA4 - Event - generate_lead",
            "firingTriggerId": ["trigger::CE - generate_lead"],
            "blockingTriggerId": [
              "trigger::Block - CMP - GA4 denied",
              "trigger::Block - CMP - uninitialized"
            ],
            "fields": {
              "event_name": "generate_lead",
              "parameters": {"method": "{{DLV - event.method}}"}
            }
          },
          {
            "object_type": "trigger",
            "name": "CE - generate_lead",
            "fields": {"event_name": "generate_lead"}
          },
          {
            "object_type": "trigger",
            "name": "Block - CMP - GA4 denied",
            "fields": {"predicate": "ga4 != granted"}
          },
          {
            "object_type": "trigger",
            "name": "Block - CMP - uninitialized",
            "fields": {"predicate": "cmp != ready"}
          }
        ]
      },
      "saved": {
        "objects": [
          {
            "object_type": "tag",
            "type": "gaawe",
            "name": "GA4 - Event - generate_lead",
            "tagId": "81",
            "path": "accounts/1/containers/2/workspaces/3/tags/81",
            "fingerprint": "server-generated",
            "firingTriggerId": ["17"],
            "blockingTriggerId": ["21", "22"],
            "fields": {
              "parameters": {"method": "{{DLV - event.method}}"},
              "event_name": "generate_lead"
            }
          },
          {
            "object_type": "trigger",
            "name": "Block - CMP - uninitialized",
            "triggerId": "21",
            "fingerprint": "server-generated",
            "fields": {"predicate": "cmp != ready"}
          },
          {
            "object_type": "trigger",
            "name": "CE - generate_lead",
            "triggerId": "17",
            "fingerprint": "server-generated",
            "fields": {"event_name": "generate_lead"}
          },
          {
            "object_type": "trigger",
            "name": "Block - CMP - GA4 denied",
            "triggerId": "22",
            "fingerprint": "server-generated",
            "fields": {"predicate": "ga4 != granted"}
          }
        ]
      }
    },
    {
      "id": "unauthorized-lead-type-is-visible",
      "expected_pass": false,
      "expected_difference_contains": "lead_type",
      "expected": {
        "objects": [
          {
            "object_type": "tag",
            "name": "GA4 - Event - generate_lead",
            "fields": {
              "event_name": "generate_lead",
              "parameters": {"method": "{{DLV - event.method}}"}
            }
          }
        ]
      },
      "saved": {
        "objects": [
          {
            "object_type": "tag",
            "name": "GA4 - Event - generate_lead",
            "fields": {
              "event_name": "generate_lead",
              "parameters": {
                "method": "{{DLV - event.method}}",
                "lead_type": "account"
              }
            }
          }
        ]
      }
    },
    {
      "id": "production-no-match-routing-regression-is-visible",
      "expected_pass": false,
      "expected_difference_contains": "default",
      "expected": {
        "objects": [
          {
            "object_type": "lookup table",
            "name": "LUT - GA4 measurement_id by hostname",
            "fields": {
              "input": "{{Page Hostname}}",
              "rows": [
                {"input": "www.example.com", "output": "G-PROD"},
                {"input": "staging.example.com", "output": "G-STAGE"}
              ],
              "default": ""
            }
          }
        ]
      },
      "saved": {
        "objects": [
          {
            "object_type": "lookup table",
            "name": "LUT - GA4 measurement_id by hostname",
            "fields": {
              "input": "{{Page Hostname}}",
              "rows": [
                {"input": "www.example.com", "output": "G-PROD"},
                {"input": "staging.example.com", "output": "G-STAGE"}
              ],
              "default": "G-PROD"
            }
          }
        ]
      }
    },
    {
      "id": "idempotent-complete-graph-is-equal",
      "expected_pass": true,
      "expected": {
        "objects": [
          {
            "object_type": "variable",
            "name": "DLV - ecommerce.items",
            "fields": {"path": "ecommerce.items", "version": 2}
          },
          {
            "object_type": "trigger",
            "name": "CE - purchase",
            "fields": {"event_name": "purchase"}
          }
        ]
      },
      "saved": {
        "objects": [
          {
            "object_type": "trigger",
            "name": "CE - purchase",
            "triggerId": "7",
            "fingerprint": "b",
            "fields": {"event_name": "purchase"}
          },
          {
            "object_type": "variable",
            "name": "DLV - ecommerce.items",
            "variableId": "4",
            "fingerprint": "a",
            "fields": {"path": "ecommerce.items", "version": 2}
          }
        ]
      }
    },
    {
      "id": "returned-ids-normalize-to-semantic-references",
      "expected_pass": true,
      "expected": {
        "objects": [
          {
            "object_type": "folder",
            "name": "Media - Commerce"
          },
          {
            "object_type": "trigger",
            "name": "CE - purchase",
            "fields": {"event_name": "purchase"}
          },
          {
            "object_type": "trigger",
            "name": "Block - CMP - Vendor denied",
            "fields": {"event_name": ".*", "predicate": "vendor != granted"}
          },
          {
            "object_type": "tag",
            "name": "Vendor - Base",
            "parentFolderId": "folder::Media - Commerce",
            "fields": {"destination": "pixel-1"}
          },
          {
            "object_type": "tag",
            "name": "Vendor - Event - Purchase",
            "parentFolderId": "folder::Media - Commerce",
            "firingTriggerId": ["trigger::CE - purchase"],
            "blockingTriggerId": ["trigger::Block - CMP - Vendor denied"],
            "setupTag": [
              {"tagName": "tag::Vendor - Base", "stopOnSetupFailure": true}
            ],
            "fields": {"event": "Purchase"}
          }
        ]
      },
      "saved": {
        "objects": [
          {
            "object_type": "tag",
            "name": "Vendor - Event - Purchase",
            "tagId": "51",
            "parentFolderId": "40",
            "firingTriggerId": ["17"],
            "blockingTriggerId": ["22"],
            "setupTag": [
              {"tagName": "50", "stopOnSetupFailure": true}
            ],
            "fields": {"event": "Purchase"}
          },
          {
            "object_type": "trigger",
            "name": "Block - CMP - Vendor denied",
            "triggerId": "22",
            "fields": {"predicate": "vendor != granted", "event_name": ".*"}
          },
          {
            "object_type": "folder",
            "name": "Media - Commerce",
            "folderId": "40"
          },
          {
            "object_type": "tag",
            "name": "Vendor - Base",
            "tagId": "50",
            "parentFolderId": "40",
            "fields": {"destination": "pixel-1"}
          },
          {
            "object_type": "trigger",
            "name": "CE - purchase",
            "triggerId": "17",
            "fields": {"event_name": "purchase"}
          }
        ]
      }
    },
    {
      "id": "wrong-returned-trigger-id-is-visible-semantically",
      "expected_pass": false,
      "expected_difference_contains": "trigger::CE - purchase",
      "expected": {
        "objects": [
          {
            "object_type": "trigger",
            "name": "CE - purchase",
            "fields": {"event_name": "purchase"}
          },
          {
            "object_type": "trigger",
            "name": "CE - add_to_cart",
            "fields": {"event_name": "add_to_cart"}
          },
          {
            "object_type": "tag",
            "name": "Vendor - Event - Purchase",
            "firingTriggerId": ["trigger::CE - purchase"],
            "fields": {"event": "Purchase"}
          }
        ]
      },
      "saved": {
        "objects": [
          {
            "object_type": "trigger",
            "name": "CE - purchase",
            "triggerId": "17",
            "fields": {"event_name": "purchase"}
          },
          {
            "object_type": "trigger",
            "name": "CE - add_to_cart",
            "triggerId": "18",
            "fields": {"event_name": "add_to_cart"}
          },
          {
            "object_type": "tag",
            "name": "Vendor - Event - Purchase",
            "tagId": "51",
            "firingTriggerId": ["18"],
            "fields": {"event": "Purchase"}
          }
        ]
      }
    },
    {
      "id": "real-gtm-parameter-and-map-order-normalize",
      "expected_pass": true,
      "expected": {
        "objects": [
          {
            "object_type": "tag",
            "name": "GA4 - Event - generate_lead",
            "type": "gaawe",
            "parameter": [
              {
                "type": "template",
                "key": "eventName",
                "value": "generate_lead"
              },
              {
                "type": "map",
                "key": "eventSettings",
                "map": [
                  {"type": "template", "key": "method", "value": "{{DLV - method}}"},
                  {"type": "boolean", "key": "debug", "value": "false"}
                ]
              }
            ],
            "monitoringMetadata": {
              "type": "map",
              "map": [
                {"type": "template", "key": "status", "value": "enabled"},
                {"type": "boolean", "key": "includeTagName", "value": "true"}
              ]
            }
          }
        ]
      },
      "saved": {
        "objects": [
          {
            "object_type": "tag",
            "name": "GA4 - Event - generate_lead",
            "tagId": "81",
            "type": "gaawe",
            "parameter": [
              {
                "type": "map",
                "key": "eventSettings",
                "map": [
                  {"type": "boolean", "key": "debug", "value": "false"},
                  {"type": "template", "key": "method", "value": "{{DLV - method}}"}
                ]
              },
              {
                "type": "template",
                "key": "eventName",
                "value": "generate_lead"
              }
            ],
            "monitoringMetadata": {
              "type": "map",
              "map": [
                {"type": "boolean", "key": "includeTagName", "value": "true"},
                {"type": "template", "key": "status", "value": "enabled"}
              ]
            }
          }
        ]
      }
    },
    {
      "id": "gtm-list-parameter-order-remains-material",
      "expected_pass": false,
      "expected_difference_contains": "array_mismatch",
      "expected": {
        "objects": [
          {
            "object_type": "tag",
            "name": "Sequenced values",
            "type": "custom",
            "parameter": [
              {
                "type": "list",
                "key": "steps",
                "list": [
                  {"type": "template", "key": "ignored-a", "value": "first"},
                  {"type": "template", "key": "ignored-b", "value": "second"}
                ]
              }
            ]
          }
        ]
      },
      "saved": {
        "objects": [
          {
            "object_type": "tag",
            "name": "Sequenced values",
            "tagId": "82",
            "type": "custom",
            "parameter": [
              {
                "type": "list",
                "key": "steps",
                "list": [
                  {"type": "template", "key": "ignored-x", "value": "second"},
                  {"type": "template", "key": "ignored-y", "value": "first"}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haiqigeng/gtm-configure/schemas/configuration-run.schema.json",
  "title": "configure-gtm configuration-run@4.0",
  "description": "Multi-target saved-state and recovery contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "requirements",
    "pipelines",
    "object_changes",
    "payload_mappings",
    "consent_topologies",
    "execution_topologies",
    "page_view_decisions",
    "first_party_data_routes",
    "inventory_dispositions",
    "container_baselines",
    "dedup_contracts",
    "saved_readback",
    "target_results",
    "official_sources",
    "external_dependencies",
    "publication_dependencies",
    "recovery_boundary",
    "idempotency"
  ],
  "properties": {
    "schema_version": {"const": "4.0"},
    "run": {"$ref": "#/$defs/run"},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "pipelines": {"type": "array", "items": {"$ref": "#/$defs/pipeline"}},
    "object_changes": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "payload_mappings": {"type": "array", "items": {"type": "object"}},
    "consent_topologies": {"type": "array", "items": {"$ref": "#/$defs/consent"}},
    "execution_topologies": {"type": "array", "items": {"type": "object"}},
    "page_view_decisions": {"type": "array", "items": {"type": "object"}},
    "first_party_data_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature": {"enum": ["analytics-user-id", "ga4-user-id", "ga4-user-provided-data", "google-ads-enhanced-conversions", "google-ads-tag-wide-user-data", "google-ads-user-provided-data-event", "google-ads-server-user-data-transport", "google-ads-server-user-provided-data-event", "vendor-advanced-matching"]},
          "server_consumer_object_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "inventory_dispositions": {"type": "array", "items": {"type": "object"}},
    "container_baselines": {"type": "array", "items": {"$ref": "#/$defs/baseline"}},
    "dedup_contracts": {"type": "array", "items": {"$ref": "#/$defs/dedup"}},
    "saved_readback": {"type": "array", "items": {"type": "object"}},
    "target_results": {"type": "array", "items": {"$ref": "#/$defs/targetResult"}},
    "official_sources": {"type": "array", "items": {"type": "object"}},
    "external_dependencies": {"type": "array", "items": {"type": "object"}},
    "publication_dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/publicationDependency"}
    },
    "recovery_boundary": {"type": ["object", "null"]},
    "idempotency": {"$ref": "#/$defs/idempotency"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "uniqueStrings": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmpty"},
      "uniqueItems": true
    },
    "status": {
      "enum": ["In progress", "Configured", "Partial", "Blocked", "Deferred"]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "execution_mode",
        "phase",
        "status",
        "started_at",
        "updated_at",
        "targets",
        "contract",
        "publication",
        "materialization"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "mode": {"enum": ["web", "server", "pipeline"]},
        "execution_mode": {
          "enum": ["isolated-lightweight", "isolated-durable", "refonte-durable"]
        },
        "phase": {"enum": ["preflight", "mutation", "readback", "complete"]},
        "status": {"$ref": "#/$defs/status"},
        "started_at": {"$ref": "#/$defs/nonEmpty"},
        "updated_at": {"$ref": "#/$defs/nonEmpty"},
        "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
        "contract": {
          "type": "object",
          "required": ["schema_version", "requirement_ids", "source_locator", "fingerprint"],
          "properties": {
            "schema_version": {"$ref": "#/$defs/nonEmpty"},
            "requirement_ids": {"$ref": "#/$defs/uniqueStrings"},
            "source_locator": {"$ref": "#/$defs/nonEmpty"},
            "fingerprint": {"$ref": "#/$defs/nonEmpty"}
          }
        },
        "publication": {
          "const": {"performed": false, "version_created": false}
        },
        "materialization": {
          "type": "object",
          "required": [
            "method",
            "owned_sections",
            "contract_fingerprint",
            "section_fingerprints"
          ],
          "properties": {
            "method": {"$ref": "#/$defs/nonEmpty"},
            "owned_sections": {"$ref": "#/$defs/uniqueStrings"},
            "contract_fingerprint": {"$ref": "#/$defs/nonEmpty"},
            "section_fingerprints": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/nonEmpty"}
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "container_type",
        "account_id",
        "container_id",
        "workspace_id",
        "adapter_capabilities"
      ],
      "properties": {
        "target_id": {"$ref": "#/$defs/nonEmpty"},
        "container_type": {"enum": ["web", "server"]},
        "account_id": {"$ref": "#/$defs/nonEmpty"},
        "container_id": {"$ref": "#/$defs/nonEmpty"},
        "workspace_id": {"$ref": "#/$defs/nonEmpty"},
        "adapter_capabilities": {"type": "object"}
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "kind", "source_locator", "status", "object_keys"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"$ref": "#/$defs/nonEmpty"},
        "source_locator": {"$ref": "#/$defs/nonEmpty"},
            "source_event": {"type": ["string", "null"]},
            "event_name": {"type": ["string", "null"]},
        "destination": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/status"},
        "object_keys": {"$ref": "#/$defs/uniqueStrings"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "target_id",
        "container_type",
        "resource_family",
        "name",
        "object_key",
        "action",
        "requirement_ids",
        "dependencies",
        "justification",
        "evidence",
        "risk",
        "state",
        "journal"
      ],
      "properties": {
        "operation_id": {"$ref": "#/$defs/nonEmpty"},
        "target_id": {"$ref": "#/$defs/nonEmpty"},
        "container_type": {"enum": ["web", "server"]},
        "resource_family": {
          "enum": [
            "built-in variable",
            "client",
            "container setting",
            "destination",
            "environment",
            "folder",
            "google tag configuration",
            "tag",
            "template",
            "transformation",
            "trigger",
            "variable",
            "workspace",
            "zone"
          ]
        },
        "name": {"$ref": "#/$defs/nonEmpty"},
        "object_key": {"$ref": "#/$defs/nonEmpty"},
        "action": {
          "enum": [
            "create",
            "update",
            "replace",
            "rename",
            "pause",
            "unpause",
            "reuse",
            "untouched",
            "remove"
          ]
        },
        "requirement_ids": {"$ref": "#/$defs/uniqueStrings"},
        "dependencies": {"$ref": "#/$defs/uniqueStrings"},
        "justification": {"$ref": "#/$defs/nonEmpty"},
        "intended": {},
        "pre_change": {},
        "object_id": {"$ref": "#/$defs/nonEmpty"},
        "new_name": {"$ref": "#/$defs/nonEmpty"},
        "approval": {"$ref": "#/$defs/mutationApproval"},
        "replacement_reason": {"$ref": "#/$defs/nonEmpty"},
        "permission_delta": {},
        "scope": {"$ref": "#/$defs/nonEmpty"},
        "evidence": {"$ref": "#/$defs/uniqueStrings"},
        "risk": {"enum": ["routine", "high-impact"]},
        "state": {
          "enum": [
            "planned",
            "in_progress",
            "saved",
            "verified",
            "failed",
            "uncertain",
            "skipped"
          ]
        },
        "journal": {"type": "array", "items": {"type": "object"}},
        "comparison": {"type": "object"},
        "saved_readback": {},
        "pre_write_readback": {},
        "pre_write_comparison": {"type": "object"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {"enum": ["create", "update", "replace", "rename", "pause", "unpause", "remove"]}
            },
            "required": ["action"]
          },
          "then": {
            "required": ["approval"],
            "properties": {
              "requirement_ids": {"minItems": 1},
              "evidence": {"contains": {"const": "approved-input"}}
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["create", "update", "replace", "rename", "pause", "unpause", "reuse", "untouched"]
              }
            },
            "required": ["action"]
          },
          "then": {"required": ["intended"]}
        },
        {
          "if": {
            "properties": {
              "action": {"enum": ["update", "replace", "rename", "pause", "unpause", "remove"]}
            },
            "required": ["action"]
          },
          "then": {"required": ["object_id", "pre_change"]}
        },
        {
          "if": {"properties": {"action": {"const": "rename"}}, "required": ["action"]},
          "then": {"required": ["new_name"]}
        },
        {
          "if": {"properties": {"action": {"const": "replace"}}, "required": ["action"]},
          "then": {"required": ["replacement_reason"]}
        },
        {
          "if": {
            "properties": {
              "resource_family": {"const": "template"},
              "action": {"enum": ["create", "update", "replace", "rename", "pause", "unpause", "remove"]}
            },
            "required": ["resource_family", "action"]
          },
          "then": {"required": ["permission_delta"]}
        },
        {
          "if": {"properties": {"state": {"const": "verified"}}, "required": ["state"]},
          "then": {"required": ["comparison", "saved_readback"]}
        },
        {
          "if": {"properties": {"action": {"enum": ["pause", "unpause"]}}},
          "then": {"properties": {"resource_family": {"const": "tag"}}}
        }
      ]
    },
    "shapeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "shape"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmpty"},
        "shape": {"enum": ["scalar", "array", "object"]}
      }
    },
    "fieldFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "field_scope",
        "destination_field",
        "requirement_ids",
        "source",
        "wire",
        "event_data",
        "destination"
      ],
      "properties": {
        "status": {"enum": ["proved", "blocked", "external"]},
        "field_scope": {"enum": ["event-parameter", "user-property", "item-parameter", "control"]},
        "destination_field": {"$ref": "#/$defs/nonEmpty"},
        "requirement_ids": {"$ref": "#/$defs/uniqueStrings"},
        "source": {"$ref": "#/$defs/shapeNode"},
        "wire": {"$ref": "#/$defs/shapeNode"},
        "event_data": {"$ref": "#/$defs/shapeNode"},
        "destination": {"$ref": "#/$defs/shapeNode"},
        "claiming_client_proof": {"type": "string"},
        "receiver_owner": {"type": "string"},
        "transformation_owner": {"type": "string"},
        "blocker": {"type": "string"},
        "external_dependency": {"type": "string"},
        "missing_behavior": {"type": "string"},
        "runtime_verification_note": {"type": "string"}
      }
    },
    "pipeline": {
      "type": "object",
      "required": [
        "pipeline_id",
        "sending_target_ids",
        "receiving_target_id",
        "request_class",
        "transport_owner",
        "endpoint_reference",
        "claiming_client_operation_id",
        "page_view_ownership",
        "event_flows",
        "field_flows",
        "consent_topology_ids",
        "dedup_contract_ids",
        "operation_dependencies",
        "cutover_operation_id"
      ],
      "properties": {
        "pipeline_id": {"$ref": "#/$defs/nonEmpty"},
        "sending_target_ids": {"$ref": "#/$defs/uniqueStrings"},
        "receiving_target_id": {"$ref": "#/$defs/nonEmpty"},
        "request_class": {"$ref": "#/$defs/nonEmpty"},
        "transport_owner": {"$ref": "#/$defs/nonEmpty"},
        "endpoint_reference": {"$ref": "#/$defs/nonEmpty"},
        "claiming_client_operation_id": {"$ref": "#/$defs/nonEmpty"},
        "page_view_ownership": {
          "type": "object",
          "required": ["owner", "occurrence", "send_page_view"],
          "properties": {
            "owner": {"$ref": "#/$defs/nonEmpty"},
            "occurrence": {"const": "initial-page-load"},
            "send_page_view": {"type": ["boolean", "null"]}
          }
        },
        "event_flows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "field_flows": {"type": "array", "items": {"$ref": "#/$defs/fieldFlow"}},
        "consent_topology_ids": {"$ref": "#/$defs/uniqueStrings"},
        "dedup_contract_ids": {"$ref": "#/$defs/uniqueStrings"},
        "operation_dependencies": {"$ref": "#/$defs/uniqueStrings"},
        "cutover_operation_id": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "consent": {
      "type": "object",
      "required": [
        "consent_topology_id",
        "destination",
        "requirement_ids",
        "consent_mode",
        "transport_behavior",
        "web_enforcement",
        "server_enforcement",
        "signal_authority",
        "signal_source",
        "unknown_state_behavior",
        "event_coverage",
        "intentional_double_gate",
        "server_tag_keys",
        "transporter_tag_keys",
        "transporter_destination_vendor_block"
      ],
      "properties": {
        "consent_topology_id": {"$ref": "#/$defs/nonEmpty"},
        "destination": {"$ref": "#/$defs/nonEmpty"},
        "requirement_ids": {"$ref": "#/$defs/uniqueStrings"},
        "consent_mode": {
          "enum": ["strict-basic", "advanced-native", "product-specific"]
        },
        "transport_behavior": {
          "enum": ["blocked", "always-transported", "conditionally-transported"]
        },
        "web_enforcement": {
          "type": "object",
          "required": ["mechanism"],
          "properties": {
            "mechanism": {
              "enum": [
                "cmp-lifecycle-plus-vendor-block",
                "business-trigger-plus-vendor-block",
                "transport-trigger-only",
                "google-consent-mode",
                "product-native",
                "none",
                "not-applicable"
              ]
            }
          }
        },
        "server_enforcement": {
          "type": "object",
          "required": ["mechanism"],
          "properties": {
            "mechanism": {
              "enum": [
                "incoming-google-consent-native",
                "server-template-native-consent",
                "server-additional-consent-check",
                "server-blocking-trigger",
                "none"
              ]
            },
            "template_support": {"type": "string"},
            "blocking_trigger_key": {"type": "string"}
          }
        },
        "signal_authority": {
          "enum": ["google-consent-mode", "third-party-cmp", "product-native", "none"]
        },
        "signal_source": {"$ref": "#/$defs/nonEmpty"},
        "server_signal_path": {"type": "string"},
        "unknown_state_behavior": {
          "enum": ["deny", "native-product-behavior", "explicit-policy"]
        },
        "event_coverage": {"$ref": "#/$defs/uniqueStrings"},
        "intentional_double_gate": {"type": "boolean"},
        "double_gate_justification": {"type": "string"},
        "server_tag_keys": {"$ref": "#/$defs/uniqueStrings"},
        "transporter_tag_keys": {"$ref": "#/$defs/uniqueStrings"},
        "transporter_destination_vendor_block": {"type": "boolean"}
      }
    },
    "dedup": {
      "type": "object",
      "required": [
        "dedup_contract_id",
        "requirement_id",
        "event_name",
        "destination",
        "strategy",
        "source_type"
      ],
      "properties": {
        "dedup_contract_id": {"$ref": "#/$defs/nonEmpty"},
        "requirement_id": {"$ref": "#/$defs/nonEmpty"},
        "event_name": {"type": "string"},
        "destination": {"type": "string"},
        "strategy": {
          "enum": [
            "single-channel",
            "server-replaces-browser",
            "dual-shared-id",
            "platform-native",
            "not-applicable"
          ]
        },
        "source_type": {
          "enum": [
            "transaction-id",
            "stable-occurrence-id",
            "approved-event-id",
            "template-native",
            "none"
          ]
        },
        "source_reference": {"type": "string"},
        "source_variable_key": {"type": "string"},
        "browser_reference": {"type": "string"},
        "transporter_reference": {"type": "string"},
        "browser_consumer_keys": {"$ref": "#/$defs/uniqueStrings"},
        "transporter_consumer_keys": {"$ref": "#/$defs/uniqueStrings"},
        "transported_parameter": {"type": "string"},
        "server_event_data_path": {"type": "string"},
        "server_generates_id": {"type": "boolean"},
        "runtime_verification_note": {"type": "string"},
        "browser_field": {"type": "string"},
        "server_field": {"type": "string"},
        "occurrence_scope": {"type": "string"},
        "companion_fields": {"type": "array"}
      }
    },
    "mutationApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "locator", "object_key", "action", "requirement_ids", "payload_sha256"],
      "properties": {
        "grade": {"const": "approved-input"},
        "locator": {"$ref": "#/$defs/nonEmpty"},
        "object_key": {"$ref": "#/$defs/nonEmpty"},
        "action": {"enum": ["create", "update", "replace", "rename", "pause", "unpause", "remove"]},
        "requirement_ids": {"$ref": "#/$defs/uniqueStrings", "minItems": 1},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "target_id",
        "captured_at",
        "complete",
        "resource_families",
        "family_counts",
        "resource_identities",
        "resources",
        "preexisting_workspace_changes",
        "capture_evidence",
        "fingerprint"
      ],
      "properties": {
        "target_id": {"$ref": "#/$defs/nonEmpty"},
        "captured_at": {"type": ["string", "null"]},
        "complete": {"type": "boolean"},
        "resource_families": {"$ref": "#/$defs/uniqueStrings"},
        "family_counts": {"type": "object"},
        "resource_identities": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/uniqueStrings"}
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "object"}
          }
        },
        "preexisting_workspace_changes": {},
        "capture_evidence": {
          "type": ["object", "null"],
          "properties": {
            "captured_by": {"const": "authenticated-adapter-runtime"},
            "source_identity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account_id", "container_id", "workspace_id", "container_type"],
              "properties": {
                "account_id": {"$ref": "#/$defs/nonEmpty"},
                "container_id": {"$ref": "#/$defs/nonEmpty"},
                "workspace_id": {"$ref": "#/$defs/nonEmpty"},
                "container_type": {"enum": ["web", "server"]}
              }
            },
            "resource_pagination": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/paginationReceipt"}
            },
            "workspace_changes_pagination": {"$ref": "#/$defs/paginationReceipt"}
          },
          "required": [
            "captured_by",
            "source_identity",
            "resource_pagination",
            "workspace_changes_pagination"
          ],
          "additionalProperties": false
        },
        "fingerprint": {"type": ["string", "null"]}
      }
    },
    "paginationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages_read", "exhausted"],
      "properties": {
        "pages_read": {"type": "integer", "minimum": 1},
        "exhausted": {"const": true}
      }
    },
    "targetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "status", "last_verified_operation_id", "recovery_boundary"],
      "properties": {
        "target_id": {"$ref": "#/$defs/nonEmpty"},
        "status": {"$ref": "#/$defs/status"},
        "last_verified_operation_id": {"type": ["string", "null"]},
        "recovery_boundary": {"type": ["object", "null"]}
      }
    },
    "publicationDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "owner", "status", "depends_on_kind", "blocks_saved_configuration"],
      "properties": {
        "kind": {
          "enum": [
            "server-publication",
            "server-recette",
            "web-cutover-publication",
            "web-pipeline-recette"
          ]
        },
        "owner": {"$ref": "#/$defs/nonEmpty"},
        "status": {"enum": ["open", "complete", "not-applicable"]},
        "depends_on_kind": {"type": ["string", "null"]},
        "blocks_saved_configuration": {"const": false}
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "remaining_actions", "observations"],
      "properties": {
        "checked": {"type": "boolean"},
        "remaining_actions": {"$ref": "#/$defs/uniqueStrings"},
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation_id", "target_id", "source", "source_identity", "observed_at", "decision", "saved", "comparison"],
            "properties": {
              "operation_id": {"$ref": "#/$defs/nonEmpty"},
              "target_id": {"$ref": "#/$defs/nonEmpty"},
              "source": {"const": "target-adapter-read"},
              "source_identity": {
                "type": "object",
                "additionalProperties": false,
                "required": ["account_id", "container_id", "workspace_id", "container_type"],
                "properties": {
                  "account_id": {"$ref": "#/$defs/nonEmpty"},
                  "container_id": {"$ref": "#/$defs/nonEmpty"},
                  "workspace_id": {"$ref": "#/$defs/nonEmpty"},
                  "container_type": {"enum": ["web", "server"]}
                }
              },
              "observed_at": {"$ref": "#/$defs/nonEmpty"},
              "decision": {"enum": ["no-op", "mutation-required"]},
              "saved": {},
              "comparison": {"type": "object"}
            }
          }
        }
      }
    }
  }
}

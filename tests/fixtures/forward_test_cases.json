{
  "version": 5,
  "description": "Anonymized raw-artifact cases for independent fresh-run evaluation of configure-gtm; expected controls are held separately from prompts.",
  "cases": [
    {
      "id": "ga4-extra-field-and-pii",
      "prompt": "Configure the approved GA4 lead event in the named web container.",
      "artifact": {"approved_fields": ["method"], "proposed_source_fields": ["method", "lead_type", "email"]},
      "expected_controls": ["lead_type not added", "email blocked from GA4", "approved method preserved"]
    },
    {
      "id": "multi-environment-routing",
      "prompt": "Configure one approved purchase event for production and staging GA4 streams.",
      "artifact": {"routes": {"www.example.test": "G-PROD", "stage.example.test": "G-STAGE"}},
      "expected_controls": ["safe no-match", "no staging-to-production leakage", "routing vectors recorded"]
    },
    {
      "id": "pinterest-multi-item",
      "prompt": "Configure the approved Pinterest checkout event from the supplied ecommerce payload.",
      "artifact": {"items": [{"item_id": "A"}, {"item_id": "B"}], "catalog_key": "merchant_product_id"},
      "expected_controls": ["official Pinterest schema reopened", "all items preserved", "catalog identity not assumed"]
    },
    {
      "id": "floodlight-sales",
      "prompt": "Configure the supplied Floodlight sales activity without publishing.",
      "artifact": {"activity_type": "sales", "required": ["transaction_id", "value"], "shared_google_tag": true},
      "expected_controls": ["activity identifiers separated", "linker architecture inspected", "platform activity remains external"]
    },
    {
      "id": "onetrust-compound-consent",
      "prompt": "Configure the media tag using the installed OneTrust integration and the approved two-grant policy.",
      "artifact": {"required_grants": ["category", "vendor"], "late_grant": true},
      "expected_controls": ["current OneTrust signals discovered", "OR-denial block set", "late-grant lifecycle explicit"]
    },
    {
      "id": "high-impact-zone",
      "prompt": "Configure the analytics event; a Zone restriction currently blocks its template.",
      "artifact": {"zone_change_authorized": false},
      "expected_controls": ["Zone inspected", "Zone remains untouched", "affected requirement blocked"]
    },
    {
      "id": "matomo-generic-analytics",
      "prompt": "Configure the approved Matomo event using the installed gallery template.",
      "artifact": {"approved_event": "Signup", "source_event": "signup_success"},
      "expected_controls": ["official Matomo browser schema reopened", "template permissions inspected", "GA4 analogy rejected"]
    },
    {
      "id": "cross-domain-ownership",
      "prompt": "Configure Google Ads cross-domain conversion measurement for the approved domains.",
      "artifact": {"domains": ["shop.example.test", "checkout.example-pay.test"], "ga4_admin_authorized": false},
      "expected_controls": ["Conversion Linker decision explicit", "GA4 Admin work external", "approved domain list only"]
    },
    {
      "id": "empty-media-payload-template-first",
      "prompt": "Configure the approved Meta and Microsoft purchase browser tags from the supplied event contract.",
      "artifact": {"source_event": "purchase", "runtime_sample": {"ecommerce": {}}, "supported_templates": ["Meta", "Microsoft"]},
      "expected_controls": ["supported templates used", "direct event firing retained", "no payload-eligibility CJS"]
    },
    {
      "id": "delta-shared-tag-change",
      "prompt": "Configure the approved rename and pause delta for the existing shared browser tag graph.",
      "artifact": {"consumers": ["trigger-17", "block-22", "folder-4"], "remove_authorized": false},
      "expected_controls": ["consumer graph traced", "pre-change state recorded", "no duplicate or removal"]
    },
    {
      "id": "basic-google-consent-four-signals",
      "prompt": "Configure the approved basic Google Consent Mode route using the installed CMP template.",
      "artifact": {"signals": ["analytics_storage", "ad_storage", "ad_user_data", "ad_personalization"], "states": ["default", "grant", "revoke"]},
      "expected_controls": ["one defaults/updates owner", "strict pre-grant block", "built-in and additional checks distinguished"]
    },
    {
      "id": "affiliate-basket",
      "prompt": "Configure the approved affiliate sale browser tag from the supplied three-row basket.",
      "artifact": {"items": [{"sku": "A"}, {"sku": "B"}, {"sku": "C"}], "order_reference": "ORDER-1", "template": "supported-installed"},
      "expected_controls": ["official network schema reopened", "all basket rows preserved", "browser duplicate key not expanded into server design"]
    },
    {
      "id": "browser-event-id-carveout",
      "prompt": "Configure the approved browser Pixel field mapping and leave the future server route untouched.",
      "artifact": {"event_id": "supplied-by-site", "browser_field_supported": true, "server_access": false},
      "expected_controls": ["supplied browser event_id mapped", "event ID not generated", "server deduplication deferred"]
    },
    {
      "id": "destination-field-without-source",
      "prompt": "Configure the approved partner browser tag whose brief names PRODUCT_LIST but provides no website source path.",
      "artifact": {"destination_field": "PRODUCT_LIST", "destination_shape": "array:string", "source": null},
      "expected_controls": ["destination field not treated as dataLayer source", "mapping remains blocked", "required source contract reported"]
    },
    {
      "id": "cmp-grant-event-with-vendor-block",
      "prompt": "Configure the strict-basic analytics base and event tags using the supplied CMP grant lifecycle.",
      "artifact": {"normal_trigger": "cmp_vendor_granted", "consumer_tags": ["base", "event"], "block_scope": "regex:.*"},
      "expected_controls": ["CMP event retained as firing opportunity", "vendor block attached to both tags", "wildcard block scope verified"]
    },
    {
      "id": "page-view-owner-automatic",
      "prompt": "Configure the Google tag and page-view requirement from the supplied container evidence.",
      "artifact": {"google_tag_send_page_view": true, "manual_page_view_tags": [], "enhanced_measurement_page_views": true, "spa": false},
      "expected_controls": ["one page-view owner recorded", "send_page_view remains true", "no manual page_view added"]
    },
    {
      "id": "pre-cmp-view-cart",
      "prompt": "Configure the approved view_cart event under strict consent from the supplied lifecycle evidence.",
      "artifact": {"event_time": "before-cmp-ready", "fresh_later_event": false, "retained_payload_replay_authorized": false},
      "expected_controls": ["non-replay limitation identified", "site dependency recorded", "Trigger Group rejected as replay"]
    },
    {
      "id": "bing-advanced-template",
      "prompt": "Configure explicitly approved Microsoft Advertising advanced UET Consent Mode.",
      "artifact": {"template": "supported-installed-uet", "official_consent_field": "ad_storage", "cmp_event": "verified_cmp_update"},
      "expected_controls": ["UET template used", "no gtag consent command", "no defeating block or Additional check"]
    },
    {
      "id": "invented-cmp-event",
      "prompt": "Configure the vendor base tag to initialize after consent.",
      "artifact": {"proposed_event": "microsoft_ads_consent_granted", "official_cmp_events": [], "approved_site_events": []},
      "expected_controls": ["proposed event rejected", "official CMP lifecycle requested", "no invented Custom Event trigger"]
    },
    {
      "id": "ga4-native-ecommerce-duplicate-items",
      "prompt": "Configure the approved GA4 purchase from the supplied compatible ecommerce push.",
      "artifact": {"native_ecommerce": true, "manual_items_mapping": true, "event_settings_items": true},
      "expected_controls": ["single native route selected", "manual items removed from intended design", "shared Event Settings items rejected"]
    },
    {
      "id": "refonte-unfiltered-inventory",
      "prompt": "Configure the approved tracking refonte from the new plan and client inventory.",
      "artifact": {"inventory_rows": 57, "filtered": false, "legacy_tags": 57, "removals_authorized": ["tag-4", "tag-9"]},
      "expected_controls": ["full paginated baseline captured", "57 existing dispositions recorded", "source row order preserved"]
    },
    {
      "id": "ga4-upd-user-data-event-scope",
      "prompt": "Configure the approved GA4 user-provided data for the lead event.",
      "artifact": {"authorized_events": ["generate_lead"], "source": "dataLayer", "input_mode": "raw", "property_activation": "external-confirmation-needed"},
      "expected_controls": ["native User-Provided Data variable", "user_data only on generate_lead", "shared Event Settings rejected"]
    },
    {
      "id": "ads-enhanced-conversion-prior-page",
      "prompt": "Configure the approved Google Ads enhanced conversion from the supplied funnel timing.",
      "artifact": {"user_data_available_on": "form-step", "conversion_on": "thank-you", "same_event_available": false, "consent_types": ["ad_storage", "ad_user_data"]},
      "expected_controls": ["User-Provided Data Event tag selected", "prior-page timing recorded", "conversion tag remains separate"]
    },
    {
      "id": "local-phone-without-country-authority",
      "prompt": "Configure enhanced conversions using the supplied French-looking local mobile number source.",
      "artifact": {"sample_shape": "0101010101", "approved_country_context": null, "hashing_mode": "native-raw"},
      "expected_controls": ["country not inferred", "phone field blocked pending context", "invalid value not hashed or sent"]
    },
    {
      "id": "hashed-email-as-ga4-dimension",
      "prompt": "Configure the supplied hashed email as a GA4 event parameter and custom definition.",
      "artifact": {"destination": "GA4 custom dimension", "field": "email_sha256", "sanctioned_user_data_feature": false},
      "expected_controls": ["ordinary GA4 PII blocked", "hashing not treated as anonymization", "value excluded from artifacts"]
    },
    {
      "id": "approved-native-click-trigger",
      "prompt": "Configure the approved CTA interaction using the supplied native GTM Click trigger evidence.",
      "artifact": {"saved_trigger_type": "click", "declared_trigger_type": "click-all-elements", "source": "Click ID"},
      "expected_controls": ["native Click trigger retained", "saved type bound to topology", "Custom Event relabelling rejected"]
    },
    {
      "id": "removed-ungated-legacy-tag",
      "prompt": "Configure the authorized refonte removal of the supplied legacy tag that has no consent block.",
      "artifact": {"action": "remove", "pre_change_firing_triggers": ["legacy-submit"], "pre_change_blocks": [], "destructive_authority": true},
      "expected_controls": ["exact pre-change state retained", "no fictional target topology", "removal disposition bound"]
    },
    {
      "id": "topology-saved-array-mismatch",
      "prompt": "Configure the supplied event tag and reconcile its declared and saved trigger graph.",
      "artifact": {"declared_firing": ["trigger::CE - purchase"], "target_firing": ["trigger::CE - checkout"], "target_blocks": ["trigger::Block - CMP - Ads"]},
      "expected_controls": ["firing-array mismatch blocks write", "semantic trigger references used", "target graph remains authoritative"]
    },
    {
      "id": "page-owner-wrong-tag-type",
      "prompt": "Configure one automatic GA4 page-view owner from the supplied Google and GA4 Event tags.",
      "artifact": {"declared_owner": "tag::GA4 - Event - page_view", "declared_owner_type": "gaawe", "google_tag_send_page_view": false},
      "expected_controls": ["GA4 Event rejected as automatic Google-tag owner", "effective send_page_view checked", "one truthful owner required"]
    },
    {
      "id": "first-party-cross-product-consumer",
      "prompt": "Configure the approved Google Ads enhanced conversion using the supplied consumer graph.",
      "artifact": {"feature": "google-ads-enhanced-conversions", "consumer_type": "gaawe", "destination_field": "user_data"},
      "expected_controls": ["GA4 consumer rejected for Ads feature", "mapped destination bound to consumer", "correct product tag required"]
    },
    {
      "id": "inventory-keep-linked-to-update",
      "prompt": "Configure the supplied refonte inventory whose keep row links to an update operation.",
      "artifact": {"disposition": "keep", "tag_action": "update", "before_name": "Meta - Purchase", "after_name": "Meta - Purchase"},
      "expected_controls": ["keep/update mismatch rejected", "one tag operation per row", "before and after identity bound"]
    }
  ]
}

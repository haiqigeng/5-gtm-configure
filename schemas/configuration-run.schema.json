{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haiqigeng/gtm-configure/schemas/configuration-run.schema.json",
  "title": "configure-gtm configuration run",
  "description": "Adapter-neutral saved-state, recovery, and recette handoff contract for one client-side GTM configuration run.",
  "$defs": {
    "verificationComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "comparator",
        "pass",
        "intended_sha256",
        "saved_sha256",
        "compared_fields",
        "differences"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "comparator": {"type": "string", "minLength": 1},
        "pass": {"type": "boolean"},
        "intended_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "saved_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "compared_fields": {
          "type": "array",
          "description": "Every top-level intended field covered by the saved-state comparison.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "differences": {
          "type": "array",
          "items": {"type": "object", "minProperties": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"pass": {"const": true}}, "required": ["pass"]},
          "then": {"properties": {"differences": {"maxItems": 0}}},
          "else": {"properties": {"differences": {"minItems": 1}}}
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "requirements",
    "object_changes",
    "payload_mappings",
    "consent_routes",
    "container_baseline",
    "execution_topologies",
    "page_view_decisions",
    "first_party_data_routes",
    "inventory_dispositions",
    "saved_readback",
    "official_sources",
    "external_dependencies",
    "recovery_boundary",
    "idempotency",
    "recette_handoff"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run": {
      "type": "object",
      "required": [
        "id",
        "phase",
        "status",
        "started_at",
        "updated_at",
        "target",
        "contract",
        "execution_mode",
        "publication"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["preflight", "mutation", "readback", "complete"]},
        "status": {
          "enum": ["In progress", "Configured", "Partial", "Blocked", "Deferred"]
        },
        "started_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "target": {
          "type": "object",
          "required": ["account_id", "container_id", "workspace_id", "container_type"],
          "properties": {
            "account_id": {"type": "string", "minLength": 1},
            "container_id": {"type": "string", "minLength": 1},
            "workspace_id": {"type": "string", "minLength": 1},
            "container_type": {"const": "web"}
          }
        },
        "contract": {
          "type": "object",
          "required": ["schema_version", "requirement_ids", "source_locator", "fingerprint"],
          "properties": {
            "schema_version": {"type": "string", "minLength": 1},
            "requirement_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "source_locator": {"type": "string", "minLength": 1},
            "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "execution_mode": {"enum": ["isolated-lightweight", "isolated-durable", "refonte-durable"]},
        "publication": {
          "type": "object",
          "required": ["performed", "version_created"],
          "properties": {
            "performed": {"const": false},
            "version_created": {"const": false}
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source_locator",
          "source_event",
          "destination",
          "status",
          "object_keys"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["analytics", "media", "consent"]},
          "source_locator": {"type": "string", "minLength": 1},
          "source_event": {"type": ["string", "null"]},
          "destination": {"type": ["string", "null"]},
          "status": {
            "enum": ["In progress", "Configured", "Partial", "Blocked", "Deferred"]
          },
          "object_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "object_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "requirement_ids",
          "action",
          "object_type",
          "name",
          "object_key",
          "dependencies",
          "state",
          "evidence",
          "journal"
        ],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "action": {
            "enum": [
              "create",
              "update",
              "replace",
              "rename",
              "pause",
              "unpause",
              "reuse",
              "untouched",
              "remove"
            ]
          },
          "object_type": {
            "enum": [
              "built-in variable",
              "container setting",
              "destination",
              "environment",
              "folder",
              "google tag configuration",
              "tag",
              "template",
              "trigger",
              "variable",
              "workspace",
              "zone"
            ]
          },
          "name": {"type": "string", "minLength": 1},
          "object_key": {"type": "string", "minLength": 1},
          "object_id": {"type": "string", "minLength": 1},
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "intended": {"type": ["object", "null"]},
          "pre_change": {"type": "object"},
          "replacement_reason": {"type": "string", "minLength": 1},
          "destructive_authorization": {"type": "boolean"},
          "permission_delta": {
            "type": "object",
            "required": ["added", "removed", "evidence_locator"],
            "properties": {
              "added": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "removed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "evidence_locator": {"type": "string", "minLength": 1}
            }
          },
          "state": {
            "enum": [
              "planned",
              "in_progress",
              "saved",
              "verified",
              "failed",
              "uncertain",
              "skipped"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "journal": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["state", "at", "note"],
              "properties": {
                "state": {
                  "enum": [
                    "planned",
                    "in_progress",
                    "saved",
                    "verified",
                    "failed",
                    "uncertain",
                    "skipped"
                  ]
                },
                "at": {"type": "string", "format": "date-time"},
                "note": {"type": "string", "minLength": 1}
              }
            }
          },
          "result": {"type": "object"},
          "comparison": {"$ref": "#/$defs/verificationComparison"},
          "error": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"state": {"const": "verified"}}, "required": ["state"]},
            "then": {
              "required": ["result", "comparison"],
              "properties": {
                "comparison": {
                  "allOf": [
                    {"$ref": "#/$defs/verificationComparison"},
                    {"properties": {"pass": {"const": true}}}
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "payload_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "field_scope",
          "destination_field",
          "source",
          "gtm_resolution",
          "template_field",
          "status",
          "provenance_locator"
        ],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "field_scope": {"enum": ["event-parameter", "user-property", "item-parameter"]},
          "destination_field": {"type": "string", "minLength": 1},
          "source": {"type": ["string", "null"]},
          "source_authority_grade": {"type": ["string", "null"]},
          "source_authority_locator": {"type": ["string", "null"]},
          "source_shape": {"type": ["string", "null"]},
          "destination_shape": {"type": ["string", "null"]},
          "shape_compatibility": {
            "type": ["string", "null"],
            "enum": ["compatible", "conversion-required", null]
          },
          "mapping_method": {
            "type": ["string", "null"],
            "enum": [
              "constant",
              "custom-javascript",
              "direct-dlv",
              "lookup-table",
              "native-template",
              "regex-table",
              "settings-variable",
              null
            ]
          },
          "gtm_resolution": {"type": ["string", "null"]},
          "template_field": {"type": ["string", "null"]},
          "missing_behavior": {"type": ["string", "null"]},
          "status": {
            "enum": ["pending", "mapped", "intentionally-omitted", "external", "blocked"]
          },
          "provenance_locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "consent_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "product",
          "mode",
          "mechanism",
          "normal_trigger",
          "blocking_triggers",
          "built_in_consent_checks",
          "additional_consent_checks",
          "unknown_behavior",
          "evidence"
        ],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "mode": {"enum": ["strict-basic", "advanced-native"]},
          "mechanism": {"enum": ["blocking-trigger", "grant-event", "native-advanced"]},
          "normal_trigger": {"type": "string", "pattern": "^(trigger::.+|2147479553|2147479572|2147479573)$"},
          "blocking_triggers": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(trigger::.+|2147479553|2147479572|2147479573)$"}
          },
          "built_in_consent_checks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "additional_consent_checks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "blocking_event_scope": {"type": ["string", "null"]},
          "scope_exception_reason": {"type": ["string", "null"]},
          "unknown_behavior": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "container_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "captured_at",
        "complete",
        "resource_families",
        "family_counts",
        "in_scope_tag_keys",
        "trigger_index",
        "preexisting_workspace_changes",
        "fingerprint"
      ],
      "properties": {
        "strategy": {"enum": ["relevant-families", "full-paginated"]},
        "captured_at": {"type": ["string", "null"], "format": "date-time"},
        "complete": {"type": "boolean"},
        "resource_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "family_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "in_scope_tag_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "trigger_index": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_key", "type", "fingerprint"],
            "properties": {
              "object_key": {"type": "string", "pattern": "^(trigger::.+|2147479553|2147479572|2147479573)$"},
              "type": {"type": "string", "minLength": 1},
              "fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "preexisting_workspace_changes": {"type": ["integer", "null"], "minimum": 0},
        "fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "execution_topologies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag_object_key",
          "requirement_ids",
          "lifecycle_role",
          "normal_triggers",
          "consent_mode",
          "blocking_trigger_keys",
          "blocking_event_scope",
          "built_in_consent_checks",
          "additional_consent_checks",
          "firing_option",
          "may_precede_cmp",
          "pre_cmp_policy",
          "page_view_capable",
          "page_view_destinations",
          "ecommerce_route",
          "manual_ecommerce_fields",
          "evidence"
        ],
        "properties": {
          "tag_object_key": {"type": "string", "minLength": 1},
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "lifecycle_role": {"enum": ["baseline-page-load", "event-driven"]},
          "normal_triggers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["trigger_object_key", "role", "type"],
              "properties": {
                "trigger_object_key": {"type": "string", "pattern": "^(trigger::.+|2147479553|2147479572|2147479573)$"},
                "role": {"enum": ["cmp-readiness-grant", "initialization-page-load", "source-event"]},
                "type": {
                  "enum": [
                    "click-all-elements",
                    "click-just-links",
                    "consent-initialization",
                    "custom-event",
                    "dom-ready",
                    "element-visibility",
                    "form-submission",
                    "history-change",
                    "initialization",
                    "javascript-error",
                    "page-view",
                    "scroll-depth",
                    "timer",
                    "trigger-group",
                    "window-loaded",
                    "youtube-video"
                  ]
                }
              }
            }
          },
          "consent_mode": {"enum": ["strict-basic", "advanced-native"]},
          "blocking_trigger_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(trigger::.+|2147479553|2147479572|2147479573)$"}
          },
          "blocking_event_scope": {"type": ["string", "null"]},
          "built_in_consent_checks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "additional_consent_checks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "firing_option": {"enum": ["once-per-event", "once-per-page", "unlimited"]},
          "may_precede_cmp": {"type": "boolean"},
          "pre_cmp_policy": {
            "enum": [
              "not-applicable",
              "source-after-readiness",
              "later-fresh-event",
              "explicit-one-time-replay",
              "external-dependency"
            ]
          },
          "page_view_capable": {"type": "boolean"},
          "page_view_destinations": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "ecommerce_route": {
            "enum": ["not-applicable", "native-data-layer", "native-custom-object", "manual"]
          },
          "manual_ecommerce_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "page_view_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "destination",
          "requirement_ids",
          "owner",
          "owner_object_key",
          "google_tag_object_key",
          "send_page_view",
          "external_dependency_ids",
          "reason",
          "evidence"
        ],
        "properties": {
          "destination": {"type": "string", "minLength": 1},
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "owner": {
            "enum": [
              "google-tag-automatic",
              "dedicated-ga4-event",
              "external",
              "intentionally-none"
            ]
          },
          "owner_object_key": {"type": ["string", "null"]},
          "google_tag_object_key": {"type": ["string", "null"]},
          "send_page_view": {"type": "boolean"},
          "external_dependency_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "first_party_data_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "feature",
          "destination_field",
          "consumer_object_keys",
          "source_priority",
          "timing",
          "hashing_owner",
          "fields",
          "consent_types",
          "external_dependency_ids",
          "evidence"
        ],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "feature": {
            "enum": [
              "ga4-user-id",
              "ga4-user-provided-data",
              "google-ads-enhanced-conversions",
              "google-ads-tag-wide-user-data",
              "google-ads-user-provided-data-event",
              "vendor-advanced-matching"
            ]
          },
          "destination_field": {"type": "string", "minLength": 1},
          "consumer_object_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "source_priority": {"enum": ["data-layer", "controlled-javascript", "dom", "automatic"]},
          "timing": {"enum": ["tag-wide", "same-event", "prior-page"]},
          "hashing_owner": {"enum": ["not-applicable", "native-raw", "prehashed-sha256"]},
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "source", "normalization", "empty_behavior"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "source": {"type": "string", "minLength": 1},
                "normalization": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "empty_behavior": {"const": "omit"}
              }
            }
          },
          "consent_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "external_dependency_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "inventory_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "source_order",
          "source_locator",
          "before_object_key",
          "before_tag_name",
          "disposition",
          "after_tag_name",
          "trigger_before",
          "trigger_after",
          "variable_changes",
          "parameter_changes",
          "consent_changes",
          "rationale",
          "operation_ids"
        ],
        "properties": {
          "row_id": {"type": "string", "minLength": 1},
          "source_order": {"type": "integer", "minimum": 0},
          "source_locator": {"type": "string", "minLength": 1},
          "before_object_key": {"type": ["string", "null"]},
          "before_tag_name": {"type": ["string", "null"]},
          "disposition": {
            "enum": ["added", "keep", "update", "remap", "pause", "remove", "replace", "supersede"]
          },
          "after_tag_name": {"type": ["string", "null"]},
          "trigger_before": {"type": "array", "items": {"type": "string"}},
          "trigger_after": {"type": "array", "items": {"type": "string"}},
          "variable_changes": {"type": "array", "items": {"type": "string"}},
          "parameter_changes": {"type": "array", "items": {"type": "string"}},
          "consent_changes": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 1},
          "operation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "saved_readback": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "object_key",
          "object_id",
          "fingerprint",
          "verified",
          "differences",
          "comparison",
          "verified_at"
        ],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "object_key": {"type": "string", "minLength": 1},
          "object_id": {"type": ["string", "null"]},
          "fingerprint": {"type": ["string", "null"]},
          "verified": {"const": true},
          "differences": {"type": "array", "maxItems": 0},
          "comparison": {"$ref": "#/$defs/verificationComparison"},
          "verified_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "official_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "title", "access_date", "supports"],
        "properties": {
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "title": {"type": "string", "minLength": 1},
          "access_date": {"type": "string", "format": "date"},
          "supports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement_ids", "owner", "action", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "requirement_ids": {

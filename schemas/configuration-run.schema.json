{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haiqigeng/5-gtm-configure/schemas/configuration-run.schema.json",
  "title": "configure-gtm configuration-run@8.0",
  "description": "Multi-target saved-state and recovery contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "requirements",
    "pipelines",
    "object_changes",
    "payload_mappings",
    "consent_topologies",
    "execution_topologies",
    "page_view_decisions",
    "first_party_data_routes",
    "inventory_dispositions",
    "container_baselines",
    "dedup_contracts",
    "final_inventories",
    "target_results",
    "official_sources",
    "external_dependencies",
    "publication_dependencies",
    "recovery_boundary",
    "idempotency"
  ],
  "properties": {
    "schema_version": {
      "const": "8.0"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "pipelines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pipeline"
      }
    },
    "object_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "payload_mappings": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/payloadMapping"
      }
    },
    "consent_topologies": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/consent"
      }
    },
    "execution_topologies": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/executionTopology"
      }
    },
    "page_view_decisions": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/pageViewDecision"
      }
    },
    "first_party_data_routes": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/firstPartyRoute"
      }
    },
    "inventory_dispositions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/inventoryDisposition"
          }
        ],
        "properties": {
          "operation_ids": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings",
            "minItems": 1
          }
        },
        "required": [
          "operation_ids"
        ],
        "unevaluatedProperties": false
      }
    },
    "container_baselines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/baseline"
      }
    },
    "dedup_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dedup"
      }
    },
    "final_inventories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finalInventory"
      }
    },
    "target_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/targetResult"
      }
    },
    "official_sources": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/officialSource"
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/externalDependency"
      }
    },
    "publication_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publicationDependency"
      }
    },
    "recovery_boundary": {
      "type": [
        "object",
        "null"
      ]
    },
    "idempotency": {
      "$ref": "#/$defs/idempotency"
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "In progress",
        "Configured",
        "Partial",
        "Blocked",
        "Deferred"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "execution_mode",
        "phase",
        "status",
        "started_at",
        "updated_at",
        "targets",
        "contract",
        "publication",
        "materialization"
      ],
      "properties": {
        "id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "mode": {
          "enum": [
            "web",
            "server",
            "pipeline"
          ]
        },
        "execution_mode": {
          "enum": [
            "isolated-durable",
            "refonte-durable"
          ]
        },
        "phase": {
          "enum": [
            "preflight",
            "mutation",
            "readback",
            "complete"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "started_at": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "updated_at": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "contract": {
          "type": "object",
          "required": [
            "schema_version",
            "requirement_ids",
            "source_locator",
            "fingerprint"
          ],
          "properties": {
            "schema_version": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
            },
            "requirement_ids": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
            },
            "source_locator": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
            },
            "fingerprint": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
            }
          }
        },
        "publication": {
          "const": {
            "performed": false,
            "version_created": false
          }
        },
        "materialization": {
          "type": "object",
          "required": [
            "method",
            "owned_sections",
            "contract_fingerprint",
            "section_fingerprints"
          ],
          "properties": {
            "method": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
            },
            "owned_sections": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
            },
            "contract_fingerprint": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
            },
            "section_fingerprints": {
              "type": "object",
              "additionalProperties": {
                "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "container_type",
        "account_id",
        "container_id",
        "workspace_id",
        "adapter_capabilities"
      ],
      "properties": {
        "target_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "container_type": {
          "enum": [
            "web",
            "server"
          ]
        },
        "account_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "container_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "workspace_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "adapter_capabilities": {
          "type": "object"
        }
      }
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source_locator",
        "status",
        "object_keys"
      ],
      "properties": {
        "id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/requirementSemantics/properties/id"
        },
        "kind": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/requirementSemantics/properties/kind"
        },
        "source_locator": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "source_event": {
          "anyOf": [
            {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/requirementSemantics/properties/source_event"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_name": {
          "anyOf": [
            {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/requirementSemantics/properties/event_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "destination": {
          "anyOf": [
            {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/requirementSemantics/properties/destination"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "object_keys": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "target_id",
        "container_type",
        "resource_family",
        "name",
        "object_key",
        "action",
        "requirement_ids",
        "dependencies",
        "justification",
        "evidence",
        "risk",
        "state",
        "journal"
      ],
      "properties": {
        "operation_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "target_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "container_type": {
          "enum": [
            "web",
            "server"
          ]
        },
        "resource_family": {
          "enum": [
            "built-in variable",
            "client",
            "container setting",
            "destination",
            "environment",
            "folder",
            "google tag configuration",
            "tag",
            "template",
            "transformation",
            "trigger",
            "variable",
            "workspace",
            "zone"
          ]
        },
        "name": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "object_key": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "action": {
          "enum": [
            "create",
            "update",
            "replace",
            "rename",
            "pause",
            "unpause",
            "reuse",
            "untouched",
            "remove"
          ]
        },
        "requirement_ids": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "dependencies": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "justification": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "intended": {},
        "pre_change": {},
        "object_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "new_name": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "approval": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/mutationApproval"
        },
        "replacement_reason": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "permission_delta": {},
        "public_identifiers": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/publicIdentifier"
          }
        },
        "evidence": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "risk": {
          "enum": [
            "routine",
            "high-impact"
          ]
        },
        "state": {
          "enum": [
            "planned",
            "in_progress",
            "saved",
            "verified",
            "failed",
            "uncertain",
            "skipped"
          ]
        },
        "journal": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "comparison": {
          "type": "object"
        },
        "saved_readback": {},
        "pre_write_readback": {},
        "pre_write_comparison": {
          "type": "object"
        },
        "assertions": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/assertions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "update",
                  "replace",
                  "rename",
                  "pause",
                  "unpause",
                  "remove"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "approval"
            ],
            "properties": {
              "requirement_ids": {
                "minItems": 1
              },
              "evidence": {
                "contains": {
                  "const": "approved-input"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "update",
                  "replace",
                  "rename",
                  "pause",
                  "unpause",
                  "reuse",
                  "untouched"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "intended"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "update",
                  "replace",
                  "rename",
                  "pause",
                  "unpause",
                  "remove"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "object_id",
              "pre_change"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "rename"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "new_name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "replace"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "replacement_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "resource_family": {
                "const": "template"
              },
              "action": {
                "enum": [
                  "create",
                  "update",
                  "replace",
                  "rename",
                  "pause",
                  "unpause",
                  "remove"
                ]
              }
            },
            "required": [
              "resource_family",
              "action"
            ]
          },
          "then": {
            "required": [
              "permission_delta"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "verified"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "comparison",
              "saved_readback"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "pause",
                  "unpause"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resource_family": {
                "const": "tag"
              }
            }
          }
        }
      ]
    },
    "pipeline": {
      "type": "object",
      "required": [
        "pipeline_id",
        "sending_target_ids",
        "receiving_target_id",
        "request_class",
        "transport_owner",
        "endpoint_reference",
        "claiming_client_operation_id",
        "page_view_ownership",
        "event_flows",
        "field_flows",
        "consent_topology_ids",
        "dedup_contract_ids",
        "operation_dependencies",
        "cutover_operation_id",
        "claiming_client"
      ],
      "properties": {
        "pipeline_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "sending_target_ids": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "receiving_target_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "request_class": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "transport_owner": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "endpoint_reference": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "claiming_client_operation_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "page_view_ownership": {
          "type": "object",
          "required": [
            "owner",
            "occurrence",
            "send_page_view"
          ],
          "properties": {
            "owner": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
            },
            "occurrence": {
              "const": "initial-page-load"
            },
            "send_page_view": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "event_flows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "field_flows": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/fieldFlow"
          }
        },
        "consent_topology_ids": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "dedup_contract_ids": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "operation_dependencies": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "cutover_operation_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "claiming_client": {
          "type": "object",
          "properties": {
            "object_key": {
              "type": "string",
              "minLength": 1
            },
            "claim_criteria": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "object_key",
            "claim_criteria"
          ],
          "additionalProperties": false
        }
      }
    },
    "dedup": {
      "type": "object",
      "required": [
        "dedup_contract_id",
        "requirement_id",
        "event_name",
        "destination",
        "strategy",
        "source_type"
      ],
      "properties": {
        "dedup_contract_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "requirement_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "event_name": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "strategy": {
          "enum": [
            "single-channel",
            "server-replaces-browser",
            "dual-shared-id",
            "platform-native",
            "not-applicable"
          ]
        },
        "source_type": {
          "enum": [
            "transaction-id",
            "stable-occurrence-id",
            "approved-event-id",
            "generated-event-id",
            "template-native",
            "none"
          ]
        },
        "source_reference": {
          "type": "string"
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "template_object_key",
            "template_type",
            "review_locator",
            "consumer_bindings"
          ],
          "properties": {
            "template_object_key": {
              "type": "string",
              "minLength": 1
            },
            "template_type": {
              "type": "string",
              "pattern": "^cvt_"
            },
            "review_locator": {
              "type": "string",
              "minLength": 1
            },
            "consumer_bindings": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nativeFieldPath"
              }
            }
          }
        },
        "source_variable_key": {
          "type": "string"
        },
        "browser_reference": {
          "type": "string"
        },
        "transporter_reference": {
          "type": "string"
        },
        "browser_consumer_keys": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "transporter_consumer_keys": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "transported_parameter": {
          "type": "string"
        },
        "server_event_data_path": {
          "type": "string"
        },
        "server_generates_id": {
          "type": "boolean"
        },
        "runtime_verification_note": {
          "type": "string"
        },
        "external_receiver_dependency_id": {
          "type": "string",
          "minLength": 1
        },
        "consumer_bindings": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nativeFieldPath"
          }
        },
        "browser_field": {
          "type": "string"
        },
        "server_field": {
          "type": "string"
        },
        "occurrence_scope": {
          "type": "string"
        },
        "companion_fields": {
          "type": "array"
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "target_id",
        "captured_at",
        "complete",
        "resource_families",
        "family_counts",
        "resource_identities",
        "resources",
        "preexisting_workspace_changes",
        "capture_evidence",
        "fingerprint"
      ],
      "properties": {
        "target_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "resource_families": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "family_counts": {
          "type": "object"
        },
        "resource_identities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "preexisting_workspace_changes": {},
        "capture_evidence": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/baselineCapture"
            }
          ]
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "finalInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "observed_at",
        "source_identity",
        "resources",
        "resource_pagination"
      ],
      "properties": {
        "target_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_identity": {
          "type": "object",
          "required": [
            "account_id",
            "container_id",
            "workspace_id",
            "container_type"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "resource_pagination": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/paginationReceipt"
          }
        }
      }
    },
    "targetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "status",
        "last_verified_operation_id",
        "recovery_boundary"
      ],
      "properties": {
        "target_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "last_verified_operation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline_error": {
          "type": "object",
          "required": [
            "at",
            "error"
          ],
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        },
        "recovery_boundary": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "publicationDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "owner",
        "status",
        "depends_on_kind",
        "blocks_saved_configuration"
      ],
      "properties": {
        "kind": {
          "enum": [
            "server-publication",
            "server-recette",
            "web-cutover-publication",
            "web-pipeline-recette",
            "post-publication-smoke"
          ]
        },
        "owner": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "status": {
          "enum": [
            "open",
            "complete",
            "not-applicable"
          ]
        },
        "depends_on_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocks_saved_configuration": {
          "const": false
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "remaining_actions",
        "observations"
      ],
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "remaining_actions": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_id",
              "target_id",
              "source",
              "source_identity",
              "observed_at",
              "decision",
              "saved",
              "comparison"
            ],
            "properties": {
              "operation_id": {
                "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
              },
              "target_id": {
                "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
              },
              "source": {
                "const": "target-adapter-read"
              },
              "source_identity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "account_id",
                  "container_id",
                  "workspace_id",
                  "container_type"
                ],
                "properties": {
                  "account_id": {
                    "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
                  },
                  "container_id": {
                    "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
                  },
                  "workspace_id": {
                    "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
                  },
                  "container_type": {
                    "enum": [
                      "web",
                      "server"
                    ]
                  }
                }
              },
              "observed_at": {
                "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
              },
              "decision": {
                "enum": [
                  "no-op",
                  "mutation-required"
                ]
              },
              "saved": {},
              "comparison": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}

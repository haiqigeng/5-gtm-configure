{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haiqigeng/5-gtm-configure/schemas/configuration-contract.schema.json",
  "title": "configure-gtm configuration-contract@10.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "route",
    "scope",
    "requirements",
    "targets",
    "pipelines",
    "consent_topologies",
    "dedup_contracts",
    "execution_topologies",
    "page_view_decisions",
    "first_party_data_routes",
    "inventory_dispositions",
    "implementation",
    "evidence",
    "external_dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "10.0"
    },
    "mode": {
      "enum": [
        "web",
        "server",
        "pipeline"
      ]
    },
    "route": {
      "enum": [
        "analytics",
        "media",
        "consent",
        "combined",
        "organization"
      ]
    },
    "scope": {
      "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/approvedScope"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/approvedRequirement"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "pipelines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pipeline"
      }
    },
    "consent_topologies": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/consent"
      }
    },
    "dedup_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dedup"
      }
    },
    "execution_topologies": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/executionTopology"
      }
    },
    "page_view_decisions": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/pageViewDecision"
      }
    },
    "first_party_data_routes": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/firstPartyRoute"
      }
    },
    "inventory_dispositions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/inventoryDisposition"
          }
        ],
        "properties": {
          "operation_keys": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings",
            "minItems": 1
          }
        },
        "required": [
          "operation_keys"
        ],
        "unevaluatedProperties": false
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "objects"
      ],
      "properties": {
        "execution_mode": {
          "enum": [
            "isolated-durable",
            "refonte-durable"
          ]
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectAction"
          }
        },
        "field_bindings": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/fieldBinding"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/externalDependency"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "container_type",
        "account_id",
        "container_id",
        "workspace_id",
        "authority"
      ],
      "properties": {
        "target_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "container_type": {
          "enum": [
            "web",
            "server"
          ]
        },
        "account_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "container_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "workspace_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "authority": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/authority"
        }
      }
    },
    "objectAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "resource_family",
        "name",
        "object_key",
        "action",
        "requirement_ids",
        "depends_on",
        "justification",
        "evidence",
        "risk"
      ],
      "properties": {
        "target_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "resource_family": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "name": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "object_key": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "action": {
          "enum": [
            "create",
            "update",
            "replace",
            "rename",
            "pause",
            "unpause",
            "reuse",
            "untouched",
            "remove"
          ]
        },
        "requirement_ids": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "depends_on": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "justification": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "evidence": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "risk": {
          "enum": [
            "routine",
            "high-impact"
          ]
        },
        "approval": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/mutationApproval"
        },
        "intended": {},
        "pre_change": {},
        "object_id": {
          "type": "string"
        },
        "new_name": {
          "type": "string"
        },
        "replacement_reason": {
          "type": "string"
        },
        "permission_delta": {},
        "public_identifiers": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/publicIdentifier"
          }
        },
        "assertions": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/assertions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "update",
                  "replace",
                  "rename",
                  "pause",
                  "unpause",
                  "remove"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "approval"
            ],
            "properties": {
              "requirement_ids": {
                "minItems": 1
              },
              "evidence": {
                "contains": {
                  "const": "approved-input"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "update",
                  "replace",
                  "rename",
                  "pause",
                  "unpause",
                  "reuse",
                  "untouched"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "intended"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "update",
                  "replace",
                  "rename",
                  "pause",
                  "unpause",
                  "remove"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "object_id",
              "pre_change"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "rename"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "new_name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "replace"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "replacement_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "resource_family": {
                "const": "template"
              },
              "action": {
                "enum": [
                  "create",
                  "update",
                  "replace",
                  "rename",
                  "pause",
                  "unpause",
                  "remove"
                ]
              }
            },
            "required": [
              "resource_family",
              "action"
            ]
          },
          "then": {
            "required": [
              "permission_delta"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "resource_family": {
                "const": "client"
              },
              "action": {
                "enum": [
                  "create",
                  "update",
                  "replace",
                  "reuse"
                ]
              }
            },
            "required": [
              "resource_family",
              "action"
            ]
          },
          "then": {
            "required": [
              "intended"
            ],
            "properties": {
              "intended": {
                "type": "object",
                "required": [
                  "type",
                  "priority"
                ],
                "properties": {
                  "type": {
                    "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
                  },
                  "priority": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_id",
        "sending_target_ids",
        "receiving_target_id",
        "request_class",
        "transport_owner",
        "endpoint_reference",
        "claiming_client",
        "page_view_ownership",
        "event_flows",
        "field_flows",
        "consent_topology_ids",
        "dedup_contract_ids",
        "operation_dependencies",
        "cutover_operation_key"
      ],
      "properties": {
        "pipeline_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "sending_target_ids": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "receiving_target_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "request_class": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "transport_owner": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "endpoint_reference": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "claiming_client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object_key",
            "claim_criteria"
          ],
          "properties": {
            "object_key": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
            },
            "claim_criteria": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
            }
          }
        },
        "page_view_ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "occurrence",
            "send_page_view"
          ],
          "properties": {
            "owner": {
              "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
            },
            "occurrence": {
              "const": "initial-page-load"
            },
            "send_page_view": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "event_flows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement_id",
              "source_event",
              "transported_event",
              "server_consumer_keys"
            ],
            "properties": {
              "requirement_id": {
                "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
              },
              "source_event": {
                "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
              },
              "transported_event": {
                "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
              },
              "server_consumer_keys": {
                "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
              }
            }
          }
        },
        "field_flows": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/fieldFlow"
          }
        },
        "consent_topology_ids": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "dedup_contract_ids": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "operation_dependencies": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "cutover_operation_key": {
          "type": "string"
        }
      }
    },
    "dedup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dedup_contract_id",
        "requirement_id",
        "event_name",
        "destination",
        "strategy",
        "source_type"
      ],
      "properties": {
        "dedup_contract_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "requirement_id": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "event_name": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "destination": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "strategy": {
          "enum": [
            "single-channel",
            "server-replaces-browser",
            "dual-shared-id",
            "platform-native",
            "not-applicable"
          ]
        },
        "source_type": {
          "enum": [
            "transaction-id",
            "stable-occurrence-id",
            "approved-event-id",
            "generated-event-id",
            "template-native",
            "none"
          ]
        },
        "source_reference": {
          "type": "string"
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "template_object_key",
            "template_type",
            "review_locator",
            "consumer_bindings"
          ],
          "properties": {
            "template_object_key": {
              "type": "string",
              "minLength": 1
            },
            "template_type": {
              "type": "string",
              "pattern": "^cvt_"
            },
            "review_locator": {
              "type": "string",
              "minLength": 1
            },
            "consumer_bindings": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nativeFieldPath"
              }
            }
          }
        },
        "source_variable_key": {
          "type": "string"
        },
        "browser_reference": {
          "type": "string"
        },
        "transporter_reference": {
          "type": "string"
        },
        "browser_consumer_keys": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "transporter_consumer_keys": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings"
        },
        "transported_parameter": {
          "type": "string"
        },
        "server_event_data_path": {
          "type": "string"
        },
        "server_generates_id": {
          "type": "boolean"
        },
        "runtime_verification_note": {
          "type": "string"
        },
        "external_receiver_dependency_id": {
          "type": "string",
          "minLength": 1
        },
        "consumer_bindings": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nativeFieldPath"
          }
        },
        "browser_field": {
          "type": "string"
        },
        "server_field": {
          "type": "string"
        },
        "occurrence_scope": {
          "type": "string"
        },
        "companion_fields": {
          "type": "array"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "grade",
        "locator"
      ],
      "properties": {
        "grade": {
          "enum": [
            "approved-input",
            "official-current",
            "container-confirmed",
            "contract-sample"
          ]
        },
        "locator": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "title": {
          "type": "string"
        },
        "decision": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/nonEmpty"
        },
        "accessed_on": {
          "type": "string",
          "format": "date"
        },
        "supports": {
          "$ref": "https://github.com/haiqigeng/5-gtm-configure/schemas/common.schema.json#/$defs/uniqueStrings",
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "grade": {
                "const": "official-current"
              }
            },
            "required": [
              "grade"
            ]
          },
          "then": {
            "required": [
              "title",
              "decision",
              "accessed_on",
              "supports"
            ]
          }
        }
      ]
    }
  }
}
